<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/layoutInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="FocaAi"
            android:textColor="#000000"
            android:textSize="42sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Logo do FocaAi"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/livro" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxWidth="280dp"
            android:text="Bem Vindo, ao aplicativo que vai te ajudar a focar melhor nos seus estudos."
            android:textColor="#173653"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonLogarInicio"
            android:layout_width="155dp"
            android:layout_height="48dp"
            android:layout_marginTop="46dp"
            android:background="@drawable/button_rounded"
            android:elevation="4dp"
            android:fontFamily="serif"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Logar"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCadastrarInicio"
            android:layout_width="155dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_rounded"
            android:elevation="4dp"
            android:fontFamily="serif"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
