<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_foca_gradient"
    tools:context=".activities.AdicionarDisciplinaActivity">

    <Button
        android:id="@+id/btnVoltarAdicionarDisciplina"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:text="‹  Voltar"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="15sp"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp" />

    <ImageButton
        android:id="@+id/btnConfiguracoesAdicionarDisciplina"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Configurações"
        android:src="@android:drawable/ic_menu_preferences"
        app:tint="@color/foca_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#55000000"
        android:layout_marginTop="106dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtNomeDisciplinaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="31dp"
        android:layout_marginTop="308dp"
        android:text="Digite o nome da disciplina:"
        android:textColor="@color/foca_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnVoltarAdicionarDisciplina"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtNomeDisciplina"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="31dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/campo_foca"
        android:hint="Nome da disciplina"
        android:inputType="textCapWords"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/foca_text"
        android:textColorHint="#777777"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtNomeDisciplinaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSalvarDisciplina"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="31dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/button_foca_pink"
        android:text="＋   Adicionar nova disciplina"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="17sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/edtNomeDisciplina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtDataAdicionarDisciplina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:textAlignment="center"
        android:textColor="@color/foca_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>