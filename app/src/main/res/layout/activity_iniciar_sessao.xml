<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_foca_gradient"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:minHeight="650dp"
    android:layout_height="wrap_content"
   
    tools:context=".activities.IniciarSessaoActivity">

    <Button
        android:id="@+id/btnVoltarIniciarSessao"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:text="‹  Voltar"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="15sp"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp" />

    <ImageButton
        android:id="@+id/btnConfiguracoesIniciarSessao"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Configurações"
        android:src="@android:drawable/ic_menu_preferences"
        app:tint="@color/foca_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#55000000"
        android:layout_marginTop="106dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSelecioneDisciplina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="103dp"
        android:text="Selecione a Disciplina"
        android:textColor="@color/foca_text"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVoltarIniciarSessao" />

    <TextView
        android:id="@+id/txtCabecalhoDisciplinas"
        android:layout_width="0dp"
        android:layout_height="59dp"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_foca_pink"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:text="Disciplinas"
        android:textColor="@color/foca_text"
        android:textSize="19sp"
        app:layout_constraintTop_toBottomOf="@id/txtSelecioneDisciplina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/listaDisciplinas"
        android:layout_width="0dp"
        android:layout_height="257dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/card_lista_foca"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/txtCabecalhoDisciplinas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioGroup
            android:id="@+id/grupoDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnIniciarSessao"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/button_foca_pink"
        android:text="▶   Iniciar Sessão"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="19sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/listaDisciplinas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
