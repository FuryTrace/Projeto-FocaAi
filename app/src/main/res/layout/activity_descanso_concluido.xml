<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_foca_gradient"
    tools:context=".activities.DescansoConcluidoActivity">

    <TextView
        android:id="@+id/txtIlustracaoDescansoConcluido"
        android:layout_width="304dp"
        android:layout_height="304dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/card_foca"
        android:gravity="center"
        android:text="🎉"
        android:textSize="112sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtMensagemDescansoConcluido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:textColor="@color/foca_text"
        android:textSize="23sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtIlustracaoDescansoConcluido" />

    <Button
        android:id="@+id/btnNovaSessao"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="54dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/button_foca_pink"
        android:text="▶   Nova Sessão"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>