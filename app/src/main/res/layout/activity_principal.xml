<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_foca_gradient"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:minHeight="650dp"
    android:layout_height="wrap_content"
   
    tools:context=".activities.PrincipalActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerPrincipal"
        android:layout_width="0dp"
        android:layout_height="106dp"
        android:background="@drawable/bg_header_foca"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/txtAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_avatar_foca"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Foto do perfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="18dp" />

        <TextView
            android:id="@+id/txtOlaUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="@color/foca_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/txtAvatar"
            app:layout_constraintStart_toEndOf="@id/txtAvatar"
            app:layout_constraintTop_toTopOf="@id/txtAvatar" />

        <ImageButton
            android:id="@+id/btnConfiguracoesPrincipal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Configurações"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/foca_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtBoasVindasPrincipal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="90dp"
        android:gravity="center"
        android:text="Pronto para focar nos estudos?"
        android:textColor="@color/foca_text"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/headerPrincipal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnIniciarNovaSessao"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/button_foca_pink"
        android:text="▶   Iniciar nova sessão"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPrincipal" />

    <Button
        android:id="@+id/btnHistoricoSessoes"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_foca_pink"
        android:text="▤   Histórico das sessões"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="17sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarNovaSessao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnAdicionarDisciplinaPrincipal"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_foca_pink"
        android:text="＋   Gerenciar disciplinas"
        android:textAllCaps="false"
        android:textColor="@color/foca_text"
        android:textSize="17sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnHistoricoSessoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtDataPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:text="Quarta-feira\n04 de novembro de 2026"
        android:textColor="@color/foca_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
